<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Fuse reaches ROMs and save states with plain stdio, so a folder the
         user picks has to be a real path. A document tree grant only yields a
         content:// URI, which fopen cannot use. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Only ever used for one thing: fetching the ROM set the user asks for
         from the ROMs panel. Nothing else in the app touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Offering the newest GitHub release to a build that came from there;
         see update/Updater.java. Taken out again for the Play build, which must
         not have it: Play updates its own apps and forbids one of its own from
         installing an APK it fetched. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Android 11 and later hide other apps from an app that has not said what it
        is looking for, and that includes hiding them from resolveActivity and
        from the chooser. Without this the Send button on a bug report finds no
        mail app on a device that has one, which looks exactly like a bug in the
        button. See feedback/Feedback.java.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>

        <!--
            A manual's own page in the library's gallery opens in whatever app
            the phone has for a PDF - see library/ui/Gallery.java's
            openManual. The identical trap as the mailto entry above: Android
            11 and later hide every PDF viewer from resolveActivity, and the
            chooser, on an app that has not said this is what it looks for.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>

        <!--
            ES-DE, so that Settings can offer to add Zedex to it. Android 11
            hides every other app from one that has not said what it looks for,
            and getPackageInfo on an undeclared package throws NameNotFound as
            though it were not installed - which is indistinguishable from the
            truth and would make the row hide itself on the devices it is for.
        -->
        <package android:name="org.es_de.frontend" />
        <package android:name="org.es_de.frontend.galaxy" />
    </queries>

    <!-- ES 3.0, which is what the renderer actually asks for:
         EGL_OPENGL_ES3_BIT and EGL_CONTEXT_CLIENT_VERSION 3 in android_gl.c,
         "#version 300 es" shaders, and -lGLESv3 in the build. Declaring 2.0
         let Play offer the app to an ES-2-only device, where eglChooseConfig
         finds nothing and the picture is black for ever with nothing said.
         No device that satisfies minSdk 30 lacks ES 3.0, so this changes who
         can install it in theory only - but the declaration was simply not
         true. -->
    <uses-feature android:glEsVersion="0x00030000" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        enableOnBackInvokedCallback is asked for rather than waited for. At
        targetSdk 36 it becomes the default whether it is declared or not, and
        the KEYCODE_BACK branch in EmulatorActivity.onKeyDown simply stops
        being reached - so the sheet's page-by-page back, leaving fullscreen,
        and back opening the menu instead of quitting would all go at once, on
        a bump of a number, with nothing to say so. Both activities that claim
        back register a dispatcher callback for API 33 and up; see
        EmulatorActivity.registerBackCallback and
        LibraryActivity.syncBackCallback, and onKeyDown/onBackPressed for the
        30-to-32 path, which has no dispatcher to register with.

        dataExtractionRules keeps a crash report, the ROM set and the tree
        grants out of a backup; res/xml/backup_rules.xml says why for each.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true">

        <!-- The launcher now, in place of EmulatorActivity: it decides for
             itself whether it belongs on screen at all, and hands straight
             over to the machine when the library is off or has no folder to
             browse - see startsInLibrary and docs/LIBRARY.md.

             app_name, not library_title: the launcher reads an activity's own
             label for what to show under its icon, in the phone's language
             rather than the app's - see Language - so this used to make the
             app appear on the home screen as "Library". The in-app title is
             set in onCreate anyway, which is the only reason this has no
             other effect. -->
        <activity
            android:name=".screen.LibraryActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Everything known about one game, opened from the library's pane -
             see screen/GameInfoActivity.java. -->
        <activity
            android:name=".screen.GameInfoActivity"
            android:label="@string/library_info"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />

        <!-- One picture or the video, full screen, swipeable across the
             rest of the same gallery - opened from a tap on a page in the
             pane or in GameInfoActivity; see library/ui/Gallery.java and
             screen/MediaViewerActivity.java. No title bar, so no label of
             its own shows; the manifest one is only for the task switcher. -->
        <activity
            android:name=".screen.MediaViewerActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />

        <activity
            android:name=".EmulatorActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="true">
            <!-- Not the launcher: LibraryActivity is, and hands over to this
                 one when the library is off or has nothing to browse - see
                 docs/LIBRARY.md. Still directly startable regardless, by
                 component name: `am start -n dev.ldlab.zedex/.EmulatorActivity`
                 appears throughout the scripts and docs, and the ES-DE
                 hand-off addresses it the same way, neither of which goes
                 through an intent filter at all. -->

            <!-- Spectrum media has no registered MIME types of its own, so
                 every one of these files - .tap, .tzx, .z80, .szx, .trd,
                 .dsk, .scl and the rest - arrives as application/octet-stream
                 and Fuse identifies the content itself.

                 Not */*: that made the app a candidate for opening every
                 file on the device, so its own recordings offered themselves
                 back to it instead of to a video player, and it competed
                 with the file manager for vnd.android.document/directory
                 when asked to show a folder. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- No BROWSABLE. It is what lets web content start an
                     activity, and a browser will not navigate to file: or
                     content: anyway - so it added no way in that works, while
                     declaring this a target for anything a page can fire. The
                     comment above wants the opposite of that. -->
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-spectrum" />
            </intent-filter>
        </activity>

        <!-- The emulator's own theme is a bare fullscreen one, which would
             leave the preference widgets looking like Android 4. -->
        <!-- Dark like the emulator, since it is mostly a picture of a black
             Spectrum keyboard, and with an action bar for Delete. -->
        <activity
            android:name=".screen.ProfileActivity"
            android:label="@string/profile_activity"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />

        <activity
            android:name=".screen.GamepadActivity"
            android:label="@string/gamepad_activity"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />

        <activity
            android:name=".screen.AboutActivity"
            android:label="@string/about_title"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />

        <activity
            android:name=".screen.SettingsActivity"
            android:label="@string/settings_title"
            android:theme="@style/SettingsTheme"
            android:exported="false" />

        <activity
            android:name=".screen.StatesActivity"
            android:label="@string/menu_states"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />
        <!-- The downloaded APK, for the system installer to read. It runs in
             another process and cannot open a file in our cache, and a file://
             URI has been refused since Android 7. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- A manual under ES-DE's own folder, when this build reached it by a
             plain path rather than through a SAF tree - see Artwork.resolve's
             file-scheme branch and Gallery.openManual. The same file:// wall
             as the provider above, over a different folder.

             android:name is EsdeManuals, not androidx.core.content.FileProvider
             again - see that class's own comment. FileProvider is keyed by
             class, not by the authority in this entry, and two <provider>
             tags both naming the framework's own class make one provider
             instance that answers only its own authority; a Uri built for
             this one is then handed to Updater's, which quite correctly
             refuses a Uri that is not its own. -->
        <provider
            android:name=".library.meta.EsdeManuals"
            android:authorities="${applicationId}.esde"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/esde_manual_paths" />
        </provider>

    </application>

</manifest>
