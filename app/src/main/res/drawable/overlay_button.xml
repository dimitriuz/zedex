<?xml version="1.0" encoding="utf-8"?>
<!--
    The background of the two buttons that show and hide the overlay keyboard.

    A disc rather than the ripple every other button uses: these two sit over
    the picture, where a rectangle of translucent grey reads as a fault in the
    game rather than a control, and where there is no bar or sheet behind them
    to say where one thing ends and the next begins.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="oval">
    <solid android:color="#cc21222a" />
    <stroke android:width="1dp" android:color="#66ffffff" />
</shape>
