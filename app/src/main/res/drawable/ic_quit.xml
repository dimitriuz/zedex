<?xml version="1.0" encoding="utf-8"?>
<!-- 24dp outline, 1.8 stroke, tinted by the row that draws it.

     The power symbol, which is what "closed, not merely put away" looks like
     everywhere else. Not the eject arrow, which is a disk coming out. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- The ring, open at the top where the stroke comes through. -->
    <path android:pathData="M7.8,6.6 a7.5,7.5 0 1,0 8.4,0"
        android:strokeColor="#ffffff"
        android:strokeWidth="1.8" android:strokeLineCap="round"
        android:strokeLineJoin="round" android:fillColor="#00000000"/>
    <path android:pathData="M12,3 V11.5" android:strokeColor="#ffffff"
        android:strokeWidth="1.8" android:strokeLineCap="round"
        android:strokeLineJoin="round" android:fillColor="#00000000"/>
</vector>
