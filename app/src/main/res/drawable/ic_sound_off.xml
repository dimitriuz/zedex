<?xml version="1.0" encoding="utf-8"?>
<!-- 24dp outline, 1.8 stroke, tinted by the row that draws it. The same
     speaker cone as ic_sound, with the waves crossed out rather than simply
     missing - a cross reads as "not", where a speaker with nothing coming
     off it could just as easily be an unfinished drawing; see ic_hide's own
     slash across ic_show for the same reasoning. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path android:pathData="M4,9 h3 l5,-4 v14 l-5,-4 h-3 z" android:strokeColor="#ffffff"
        android:strokeWidth="1.8" android:strokeLineCap="round"
        android:strokeLineJoin="round" android:fillColor="#00000000"/>
    <path android:pathData="M14.5,9.5 L20.5,15.5 M20.5,9.5 L14.5,15.5" android:strokeColor="#ffffff"
        android:strokeWidth="1.8" android:strokeLineCap="round"
        android:strokeLineJoin="round" android:fillColor="#00000000"/>
</vector>
