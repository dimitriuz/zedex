    <string name="about_title">About</string>
    <string name="about_banner">Zedex — a modern ZX Spectrum emulator for Android</string>
    <string name="about_tagline">A modern ZX Spectrum emulator for Android</string>
    <string name="about_what">Every Spectrum from the 16K to the +3, with the tape deck, the disk drives, the AY and the joysticks, on Fuse\'s emulation core.</string>
