    <string name="roms_missing">Some ROMs are missing</string>
    <string name="roms_missing_message">%1$d of the machines\' ROMs are not in the folder:\n\n%2$s\n\nThe machines that need them will not start. Everything else will.</string>
    <string name="roms_missing_more">, and %1$d more</string>
