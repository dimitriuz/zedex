    <string name="roms_downloading_message">Fetching a set from\n\n%1$s\n\nabout 350 kB. The machine starts by itself when they arrive.</string>
    <string name="roms_download_did_not">Download failed</string>
    <string name="roms_download_failed_message">%1$s\n\n%2$s\n\nTry again, or one of the other two ways below.</string>
