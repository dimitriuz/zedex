<?xml version="1.0" encoding="utf-8"?>
<!--
    Only because a manual can be reached as a plain path when this build has
    All files access; see Artwork.resolve's file-scheme branch. A file:// Uri
    handed to another app's ACTION_VIEW has been refused since Android 7
    (update_paths.xml exists for the identical reason, over the APK the
    updater downloads); this is what lets Gallery.openManual hand the same
    file over as a content:// one instead - see EsdeManuals for why that has
    to be its own provider class.

    Two roots: FileProvider matches a file against every declared root whose
    path is a prefix of it and uses the longest one that matches, not
    whichever is declared first, so the narrow one below wins for the
    ordinary case on its own and the wide one only ever applies to a media
    folder ES-DE was configured to keep somewhere else under its own folder.
    Manuals are the only thing this provider is ever asked for - Artwork's
    pictures and video are decoded in this app, never handed to another one
    - so scoping tightly to where they actually live means a mistake here
    could only ever expose a manual, not covers, saves, or anything else
    EsDe.folder() reaches.
-->
<paths>
    <!-- ES-DE's own default MediaDirectory - see EsdeLink.DEFAULT_MEDIA -
         which is where a manual lives unless ES-DE was told to keep its
         media somewhere else. -->
    <external-path name="esde_manuals" path="ES-DE/downloaded_media/zxspectrum/manuals" />

    <!-- The fallback: a configured MediaDirectory that still lies under
         ES-DE's own folder - see EsdeLink.relativeToEsde - just not at the
         default path above. Wider than the root really needs for the
         common case, but a manual under a folder this app cannot yet name
         specifically is still better reached than not opened at all. -->
    <external-path name="esde" path="ES-DE" />

    <!-- Where a manual this app scraped for itself is served from.
         
         Not the media folder it actually lives in, because that folder has
         no fixed path to declare: Storage.root is the data folder, which is
         a preference, and its own default falls back through Documents to
         getExternalFilesDirs and finally getFilesDir - internal storage,
         which no external-path could ever reach. A root that cannot be
         written down is a root FileProvider cannot match, and the failure
         was exactly that: getUriForFile threw, Manuals caught it, and every
         scraped manual on every screen answered "could not open that file".
         
         So one is copied here instead and handed over from a place this app
         can always name. It keeps the tight scoping the roots above were
         chosen for - a mistake here exposes one copied manual, not a data
         folder - and it is the only form of the fix that works when the
         data folder is on internal storage. -->
    <cache-path name="manuals" path="manuals/" />
</paths>
