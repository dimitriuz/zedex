<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's own housekeeping, as against the machine's: where it keeps things,
    what it writes them as, and whether it looks for a newer version of itself.

    Four headings because they are four unrelated questions. The other tabs are
    each one subject and need none; this one is the tab for everything that is
    about Zedex rather than about a Spectrum.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/settings_group_language">
        <ListPreference
            android:key="language"
            android:title="@string/settings_language"
            android:entries="@array/language_names"
            android:entryValues="@array/language_values"
            android:defaultValue="" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_folders">
        <Preference
            android:key="statesRoot"
            android:title="@string/settings_data_folder"
            android:summary="@string/settings_data_folder_summary" />
        <Preference
            android:key="contentTree"
            android:title="@string/settings_content_folder"
            android:summary="@string/settings_content_folder_summary" />
        <!--
            Directly below the folder it needs, so cause and effect are
            adjacent - see docs/LIBRARY.md, "A content folder is the gate".
            Disabled and its summary swapped for settings_library_needs_folder
            until contentTree holds something; see SettingsActivity, which
            keeps that in step with picking the folder and with resuming.
        -->
        <SwitchPreferenceCompat
            android:key="library"
            android:title="@string/settings_library"
            android:summary="@string/settings_library_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!--
        Hides itself where there is no ES-DE to add anything to; see
        SettingsActivity, and the updates category below for the same idea.
    -->
    <PreferenceCategory
        android:key="frontends"
        android:title="@string/settings_group_frontends">
        <Preference
            android:key="esde"
            android:title="@string/settings_esde"
            android:summary="@string/settings_esde_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_saving">
        <ListPreference
            android:key="snapshotFormat"
            android:title="@string/settings_snapshot_format"
            android:entries="@array/format_names"
            android:entryValues="@array/format_values"
            android:defaultValue="szx" />
        <ListPreference
            android:key="tapeFormat"
            android:title="@string/settings_tape_format"
            android:entries="@array/tape_format_names"
            android:entryValues="@array/tape_format_values"
            android:defaultValue="tap" />
    </PreferenceCategory>

    <!--
        The whole category hides itself where updating is impossible - a Play
        install updates itself, and the Play build has no updater in it at all.
        Hiding the switch alone would leave a heading over nothing; see
        SettingsActivity.
    -->
    <PreferenceCategory
        android:key="updates"
        android:title="@string/settings_group_updates">
        <SwitchPreferenceCompat
            android:key="updateCheck"
            android:title="@string/settings_update_check"
            android:summary="@string/settings_update_check_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
