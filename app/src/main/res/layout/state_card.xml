<?xml version="1.0" encoding="utf-8"?>
<!--
    One saved state in the grid: the screen as it was, what it is called and
    when, and the two things that can be done to it. The picture is the size of
    the cell and 4:3 like the machine, so a screenful of these reads as a shelf
    of screens rather than a list of names.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:padding="6dp">

    <!--
        0dp with no weight, which would ordinarily mean invisible: the height
        is set per cell in StatesActivity.getView, from the grid's own column
        width, because the picture is 4:3 against a width the grid only knows
        at bind time. A number here would be overwritten on every bind and
        would only mislead about where the size comes from.
    -->
    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:background="#000000"
        android:contentDescription="@null"
        tools:ignore="Suspicious0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#22ffffff">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textColor="#ededf2" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="#8b8b99" />
        </LinearLayout>

        <!--
            40dp, not the 48 a touch target is asked to be, and measured
            rather than assumed. Two 48dp buttons leave about 92dp of a
            200dp card for the name, and at that width "Snapshot 2" renders
            as "Snapshot…" - two states in a row both reading the same thing,
            which is a worse answer than a small button. The card cannot
            spare the width; a 48dp target here needs the grid re-thought,
            not a number changed. See review/FINDINGS.md, 5.5.
        -->
        <ImageButton
            android:id="@+id/rename"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit"
            android:tint="#8b8b99" />

        <ImageButton
            android:id="@+id/delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_trash"
            android:tint="#8b8b99" />
    </LinearLayout>
</LinearLayout>
