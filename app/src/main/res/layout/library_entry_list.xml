<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in the list shape: a small picture for what it is, and its name -
    see library/ui/EntryAdapter.java. No second line any more: the pane
    already says the size and the date for whatever is selected, and a folder
    of a couple of thousand tapes needs the room a second line on every one
    of them costs more than it needs the line itself.

    40dp rather than Material's 48dp single-line spec: that figure is about a
    *touch* target on a phone held one-handed, and here the whole row is
    already the target - the app's own menu rows are not much taller than
    this. 14sp rather than 15 for the same reason the row shrank: the names
    in this folder run long ("Aliens Neoplasma II v1.6 EN 128K
    (2024)(Sinc LAIR).tap"), and a step smaller fits more of one before the
    ellipsis, on top of fitting more rows on screen at once.

    The icon has no android:tint here any more - EntryAdapter applies and
    clears it in code, since this same view shows a scraped picture in place
    of the type icon once one resolves, and a picture must not come out
    tinted the muted grey a vector icon is.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:foreground="?android:attr/selectableItemBackground">
    <!-- The ripple is the foreground rather than the background, so the
         selected row's own tint - set in code, on the background - shows
         through it instead of being replaced by it. -->

    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:maxLines="1"
        android:ellipsize="middle"
        android:textSize="14sp"
        android:textColor="#ededf2" />
</LinearLayout>
