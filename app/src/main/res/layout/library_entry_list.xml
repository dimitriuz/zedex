<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in the list shape: an icon for what it is, its name, and whatever
    of its size and date could be read - see library/ui/EntryAdapter.java.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:foreground="?android:attr/selectableItemBackground">
    <!-- The ripple is the foreground rather than the background, so the
         selected row's own tint - set in code, on the background - shows
         through it instead of being replaced by it. -->

    <ImageView
        android:id="@+id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:tint="#8b8b99"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textSize="15sp"
            android:textColor="#ededf2" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="#8b8b99" />
    </LinearLayout>
</LinearLayout>
