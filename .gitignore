# upstream sources: ~100 MB, fetched and checksum-verified by
# scripts/build-native.sh
/vendor/

# native build trees and their outputs
/build-native/
/build/
/app/build/
/app/src/main/jniLibs/
/app/src/main/assets/fuse/


# local toolchain config
/local.properties
/.gradle/
/.idea/
__pycache__/

# Sidecars an image viewer leaves beside an asset.
*.xmp

# Generated by scripts/build-demo.py: pure arithmetic, no reason to carry it.
/demo/pt3tables.inc

# The test tapes, assembled from their .asm on demand. Unlike demo/zedex.tap
# they do not ship, so there is nothing to carry.
/demo/tstest.tap
/demo/turbotest.tap

# Local code-review findings: working notes, not part of the project.
/review/

# Subagent-driven development scratch: ledgers, briefs, review packages.
/.superpowers/
