 peripherals/ula.h |   7 ++-
 settings.dat      |   1 +
 sound.c           |  11 +++--
 5 files changed, 148 insertions(+), 4 deletions(-)

diff --git a/machine.c b/machine.c
index 57415b8..009458a 100644
--- a/machine.c
+++ b/machine.c
@@ -45,6 +45,7 @@
 #include "settings.h"
 #include "snapshot.h"
 #include "sound.h"
+#include "spectrum.h"
 #include "tape.h"
 #include "timer/timer.h"
 #include "ui/ui.h"
@@ -371,9 +372,62 @@ machine_reset( int hard_reset )
