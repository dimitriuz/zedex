+/* Turbo mode: the clones ran their Z80 at 7MHz rather than 3.5, keeping the
+   50Hz frame and everything else about the display. So it is not the emulation
+   speed setting, which makes the whole machine - music, tape, real time - run
+   faster: it is twice as many tstates inside a frame that still lasts a
+   fiftieth of a second, which is what the hardware did, and why a game gets
+   twice the work done between two interrupts while its music plays at the same
+   tempo.
+
+   Everything in machine_timings is therefore doubled together, so that a frame
+   still takes tstates_per_frame / processor_speed seconds. The AY is the one
+   thing that does not follow, since it has a clock of its own: see
+   AY_CLOCK_RATIO in sound.c, which multiplies by this.
+
+   settings_current.turbo is the only copy of whether it is on, so that the
+   command line - which is read before there is a machine to tell - and the
+   switch in the UI cannot disagree. */
+
+/* Which machines had one. The Russian clones, the same ones that could have a
+   TurboSound; a Sinclair machine ran at 3.5MHz and nothing else. */
+static int
+machine_has_turbo_type( libspectrum_machine machine )
+{
+  switch( machine ) {
+  case LIBSPECTRUM_MACHINE_PENT:
+  case LIBSPECTRUM_MACHINE_PENT512:
+  case LIBSPECTRUM_MACHINE_PENT1024:
+  case LIBSPECTRUM_MACHINE_SCORP:
+    return 1;
+  default:
+    return 0;
+  }
+}
+
+/* Whether the machine in front of the user could have had a turbo at all,
+   which is a different question from whether it is switched on: a UI has to
+   know not to offer it on a 48K. */
+int
+machine_can_turbo( void )
+{
+  return machine_current && machine_has_turbo_type( machine_current->machine );
+}
+
+int
+machine_turbo_factor( void )
+{
+  if( !machine_current ) return 1;
+
+  return ( settings_current.turbo &&
+           machine_has_turbo_type( machine_current->machine ) ) ? 2 : 1;
+}
+
 static void
 machine_set_const_timings( fuse_machine_info *machine )
 {
+  int factor;
+
   /* Pull timings we use repeatedly out of libspectrum and store them
      for ourself */
   machine->timings.processor_speed =
@@ -390,6 +444,22 @@ machine_set_const_timings( fuse_machine_info *machine )
     libspectrum_timings_interrupt_length( machine->machine );
   machine->timings.tstates_per_frame =
     libspectrum_timings_tstates_per_frame( machine->machine );
+
+  /* All of it together, so that a frame lasts what it always did. The borders
+     and the line length are in here because the display is driven from them:
+     leave those alone and the picture would be drawn in the first half of
+     every frame. */
+  factor = ( settings_current.turbo &&
+             machine_has_turbo_type( machine->machine ) ) ? 2 : 1;
+  if( factor != 1 ) {
+    machine->timings.processor_speed   *= factor;
+    machine->timings.left_border       *= factor;
+    machine->timings.horizontal_screen *= factor;
+    machine->timings.right_border      *= factor;
+    machine->timings.tstates_per_line  *= factor;
+    machine->timings.interrupt_length  *= factor;
+    machine->timings.tstates_per_frame *= factor;
+  }
 }
 
 static void
@@ -424,6 +494,57 @@ machine_set_variable_timings( fuse_machine_info *machine )
   }
 }
 
+/* Turbo on or off while the machine runs. Called at the end of a frame, which
+   is where the UI's events are drained, so tstates is back to nearly nothing
+   and no event has to be moved but the frame's own.
+
+   The caller restarts the sound: sound_init() reads the processor speed once,
+   for the blip buffer's clock rate, and a doubled machine feeding a buffer
+   clocked for half of it plays everything an octave down. */
+int
+machine_set_turbo( int turbo )
+{
+  size_t i;
+  libspectrum_dword frame;
+
+  if( !machine_current ) { settings_current.turbo = turbo; return 0; }
+  if( settings_current.turbo == turbo ) return 0;
+
+  settings_current.turbo = turbo;
+
+  machine_set_const_timings( machine_current );
+  machine_set_variable_timings( machine_current );
+
+  frame = machine_current->timings.tstates_per_frame;
+
+  /* The contention array is per tstate and the frame just changed length.
+     Every machine with a turbo is uncontended, so this fills with zeroes -
+     but it is filled rather than assumed, since the array is indexed by a
+     running tstate count and stale entries past the old frame length would
+     be read on the very first turbo frame. */
+  if( frame > ULA_CONTENTION_SIZE ) frame = ULA_CONTENTION_SIZE;
+  for( i = 0; i < frame; i++ ) {
+    ula_contention[ i ] = machine_current->ram.contend_delay( i );
+    ula_contention_no_mreq[ i ] = machine_current->ram.contend_delay_no_mreq( i );
+  }
+
+  /* spectrum_frame() has already scheduled the next frame's end at the old
+     length. Leaving it there costs one frame at the wrong speed turning turbo
+     on, and one that lasts twice as long - a visible stutter - turning it
+     off. */
+  event_remove_type( spectrum_frame_event );
+  event_add( machine_current->timings.tstates_per_frame, spectrum_frame_event );
+
+  /* A snapshot loaded at the other setting, or an unlucky moment, can leave
+     the machine past the end of a frame it is no longer in. */
+  if( tstates > machine_current->timings.tstates_per_frame )
+    tstates = machine_current->timings.tstates_per_frame;
+
+  display_refresh_all();
+
+  return 0;
+}
+
 static void
 machine_end( void )
 {
diff --git a/machine.h b/machine.h
index f8d4d80..053d4c4 100644
--- a/machine.h
+++ b/machine.h
@@ -109,4 +109,16 @@ int machine_load_rom( int page_num, const char *filename, const char *fallback,
 
 int machine_reset( int hard_reset );
 
+/* Turbo mode: a 7MHz Z80 on the machines that had one, with the frame still
+   50Hz. Whether it is on is settings_current.turbo; this applies a change to
+   the machine that is already running. See machine.c. */
+int machine_set_turbo( int turbo );
+
+/* 2 where the machine is running in turbo and 1 everywhere else, for the
+   things that have a clock of their own and must not follow the CPU. */
+int machine_turbo_factor( void );
+
+/* Whether this machine could have one, switched on or not. */
+int machine_can_turbo( void );
+
 #endif			/* #ifndef FUSE_MACHINE_H */
diff --git a/peripherals/ula.h b/peripherals/ula.h
index f0eaeaf..08613db 100644
--- a/peripherals/ula.h
+++ b/peripherals/ula.h
@@ -30,7 +30,12 @@
 #define ULA_PORT_EAR_BIT      0x10  /* bit 4: EAR output (speaker) */
 #define ULA_PORT_EAR_IN_BIT   0x40  /* bit 6: EAR input (tape signal) */
 
-#define ULA_CONTENTION_SIZE 80000
+/* One entry per tstate in a frame, so it has to cover the longest frame any
+   machine has: the Pentagon's 71680, doubled by turbo mode (see
+   machine_set_turbo), which is the only thing here that makes a frame longer
+   than the hardware ever did. The array is indexed by a running tstate count
+   with no bound check of its own, so this is a real limit and not a hint. */
+#define ULA_CONTENTION_SIZE 160000
 
 /* How much contention do we get at every tstate when MREQ is active? */
 extern libspectrum_byte ula_contention[ ULA_CONTENTION_SIZE ];
