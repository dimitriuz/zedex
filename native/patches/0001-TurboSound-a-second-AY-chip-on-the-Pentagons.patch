@@ -29,11 +29,29 @@
 
 #define AY_REGISTERS 16
 
+/* A TurboSound is two AY-3-8912s behind the one pair of ports, with a write to
+   the register port choosing which of them the following writes address: 0xff
+   for the first chip and 0xfe for the second. A real AY latches only the
+   bottom four bits of that byte, so on a machine with one chip those two
+   values are registers 15 and 14 and nothing has changed.
+
+   The second chip exists on every machine here - it is registers and a little
+   generator state, and the machine that has one is decided at reset - but only
+   the machines ay_chips is set for ever hear it. */
+#define AY_CHIPS 2
+
 typedef struct ayinfo {
   int current_register;
   libspectrum_byte registers[ AY_REGISTERS ];
 } ayinfo;
 
+/* How many of the AY_CHIPS this machine has: 1 everywhere, 2 on a machine with
+   a TurboSound. Set at reset, and read by sound.c, which mixes that many. */
+extern int ay_chips;
+
+/* Which chip the ports currently address; always 0 where ay_chips is 1. */
+extern int ay_current_chip;
+
 void ay_register_startup( void );
 
 libspectrum_byte ay_registerport_read( libspectrum_word port, libspectrum_byte *attached );
