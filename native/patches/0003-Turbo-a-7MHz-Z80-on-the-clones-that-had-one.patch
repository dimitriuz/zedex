 int machine_reset( int hard_reset );
 
+/* Turbo mode: a 7MHz Z80 on the machines that had one, with the frame still
+   50Hz. Whether it is on is settings_current.turbo; this applies a change to
+   the machine that is already running. See machine.c. */
+int machine_set_turbo( int turbo );
+
+/* 2 where the machine is running in turbo and 1 everywhere else, for the
+   things that have a clock of their own and must not follow the CPU. */
+int machine_turbo_factor( void );
+
 #endif			/* #ifndef FUSE_MACHINE_H */
diff --git a/peripherals/ula.h b/peripherals/ula.h
index ce11bd5..beb94e1 100644
--- a/peripherals/ula.h
+++ b/peripherals/ula.h
@@ -24,7 +24,12 @@
 #ifndef FUSE_ULA_H
 #define FUSE_ULA_H
 
-#define ULA_CONTENTION_SIZE 80000
+/* One entry per tstate in a frame, so it has to cover the longest frame any
+   machine has: the Pentagon's 71680, doubled by turbo mode (see
+   machine_set_turbo), which is the only thing here that makes a frame longer
+   than the hardware ever did. The array is indexed by a running tstate count
+   with no bound check of its own, so this is a real limit and not a hint. */
+#define ULA_CONTENTION_SIZE 160000
 
 /* How much contention do we get at every tstate when MREQ is active? */
 extern libspectrum_byte ula_contention[ ULA_CONTENTION_SIZE ];
