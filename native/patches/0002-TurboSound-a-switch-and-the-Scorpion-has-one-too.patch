From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zedex <zedex@invalid>
Date: Wed, 5 Aug 2026 15:04:47 +0200
Subject: [PATCH 2/2] TurboSound: a switch, and the Scorpion has one too

Whether the second chip is there is now settings_current.turbosound, and
ay_update_chips() works out how many chips are playing from that and from the
machine.  Both can change while the machine runs - the setting is a switch, and
turning it off has to silence the second chip between one frame and the next
rather than at the next reset - so the reset is no longer the only place that
decides, and unplugging it while the second chip was the one being addressed
puts the ports back on the first.

The Scorpion joins the Pentagons as a machine that can have one; it is the same
part of the world and the same expansion.

settings.c and settings.h are in the patch because they are generated from
settings.dat by perl and the release ships them, so a tree that has not run the
codegen yet still has a settings_current.turbosound to compile against.
---
 peripherals/sound/ay.c | 29 +++++++++++++++++++++++------
 peripherals/sound/ay.h |  7 ++++++-
 settings.c             | 39 +++++++++++++++++++++++++++++----------
 settings.dat           |  1 +
 settings.h             |  1 +
 5 files changed, 60 insertions(+), 17 deletions(-)

diff --git a/peripherals/sound/ay.c b/peripherals/sound/ay.c
index 1f5a177..270477c 100644
--- a/peripherals/sound/ay.c
+++ b/peripherals/sound/ay.c
@@ -34,6 +34,7 @@
 #include "periph.h"
 #include "peripherals/printer.h"
 #include "psg.h"
+#include "settings.h"
 #include "sound.h"
 
 /* Unused bits in the AY registers are silently zeroed out; these masks
@@ -156,9 +157,10 @@ ay_register_startup( void )
                             ARRAY_SIZE( dependencies ), ay_init, NULL, NULL );
 }
 
-/* Which machines have a TurboSound. It was a Russian expansion and the clones
-   are where it is found, so this is the Pentagons: on anything else the two
-   chip select bytes stay what they always were, registers 15 and 14. */
+/* Which machines can have a TurboSound. It was a Russian expansion and the
+   clones are where it is found, so this is the Pentagons and the Scorpion: on
+   anything else the two chip select bytes stay what they always were,
+   registers 15 and 14. */
 static int
 machine_has_turbosound( void )
 {
@@ -166,20 +168,35 @@ machine_has_turbosound( void )
   case LIBSPECTRUM_MACHINE_PENT:
   case LIBSPECTRUM_MACHINE_PENT512:
   case LIBSPECTRUM_MACHINE_PENT1024:
+  case LIBSPECTRUM_MACHINE_SCORP:
     return 1;
   default:
     return 0;
   }
 }
 
+/* How many chips are playing: the machine has to be one that can have a second
+   one and the user has to want it. Call this after either can have changed -
+   the setting is a switch rather than something only a reset reads. */
+void
+ay_update_chips( void )
+{
+  if( !machine_current ) return;
+
+  ay_chips = ( machine_has_turbosound() && settings_current.turbosound )
+             ? AY_CHIPS : 1;
+
+  /* Unplugging it while the second chip was the one being addressed would
+     leave every following write going to a chip nothing plays. */
+  if( ay_current_chip >= ay_chips ) ay_current_chip = 0;
+}
+
 static void
 ay_reset( int hard_reset GCC_UNUSED )
 {
   int chip;
 
-  /* The machine is what decides this, and a reset is when the machine can
-     have changed; sound.c reads it every frame. */
-  ay_chips = machine_has_turbosound() ? AY_CHIPS : 1;
+  ay_update_chips();
   ay_current_chip = 0;
 
   /* Both chips, whether this machine hears the second one or not: state left
diff --git a/peripherals/sound/ay.h b/peripherals/sound/ay.h
index cc7d73a..a7838a9 100644
--- a/peripherals/sound/ay.h
+++ b/peripherals/sound/ay.h
@@ -46,9 +46,14 @@ typedef struct ayinfo {
 } ayinfo;
 
 /* How many of the AY_CHIPS this machine has: 1 everywhere, 2 on a machine with
-   a TurboSound. Set at reset, and read by sound.c, which mixes that many. */
+   a TurboSound and settings_current.turbosound. Read by sound.c, which mixes
+   that many. */
 extern int ay_chips;
 
+/* Works ay_chips out again. Call it when the machine or the setting has
+   changed; ay_reset() does. */
+void ay_update_chips( void );
+
 /* Which chip the ports currently address; always 0 where ay_chips is 1. */
 extern int ay_current_chip;
 
